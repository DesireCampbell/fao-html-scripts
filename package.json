{
  "name": "fao-html-scripts",
  "displayName": "FAO HTML Scripts",
  "description": "A collection of scripts to help in HTML production",
  "repository": {
    "type": "git",
    "url": "https://github.com/DesireCampbell/fao-html-scripts.git"
  },
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "fao-html-scripts.helloWorld",
        "title": "FAO Hello World"
      },
      {
        "command": "fao-html-scripts.pasteAsHTML",
        "title": "FAO Paste as HTML"
      },
      {
        "command": "fao-html-scripts.stripStyles",
        "title": "FAO Strip Styles"
      },
      {
        "command": "fao-html-scripts.formatCharts",
        "title": "FAO Format Charts"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fao-html-scripts.pasteAsHTML",
          "when": "editorTextFocus"
        },
        {
          "command": "fao-html-scripts.stripStyles",
          "when": "editorTextFocus"
        },
        {
          "command": "fao-html-scripts.formatCharts",
          "when": "editorTextFocus"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fao-html-scripts",
          "title": "FAO HTML Scripts",
          "icon": "resources/icon.png"
        }
      ]
    },
    "viewsWelcome": [
			{
				"view": "fao-html-scripts-view",
				"contents": "FAO HTML helper \n[$(clippy) Paste as HTML](command:fao-html-scripts.pasteAsHTML)\n[$(clear-all) Strip Styles](command:fao-html-scripts.stripStyles)\n[$(list-ordered) Fix Lists](command:fao-html-scripts.fixLists)\n[$(graph-line) Format Charts](command:fao-html-scripts.formatCharts)\n[$(table) Format Tables](command:fao-html-scripts.formatTables)\n[$(quote) Footnote Ref](command:fao-html-scripts.footnoteRef)\n[$(open-in-window) Target Blank](command:fao-html-scripts.targetBlank)\n[$(text-size) Fix Headings](command:fao-html-scripts.fixHeadings)\n[$(comment) English To French](command:fao-html-scripts.englishToFrench) \n\n"
			}
		],
    "views": {
      "fao-html-scripts": [
        {
          "id": "fao-html-scripts-view",
          "name": "FAO HTML Scripts"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
